// ============================================================================
// PRISMA SCHEMA
// ============================================================================
//
// Foundation models for the app:
//   1. Authentication (Better Auth)   — User, Session, Account, Verification, TwoFactor
//   2. Multi-tenant organizations     — Organization, Member, Invitation, OrganizationRole
//   3. Subscription billing            — Subscription
//   4. Feature-gate usage tracking     — UsageMetrics
//   5. Audit logging                   — ActivityLog
//
// Add your own domain models BELOW these with `organizationId` as the
// tenancy key.
//
// SOURCE OF TRUTH RULE: Prisma is the source of truth for any data shape
// it can describe. Never duplicate a database type into a TS interface.
// Import from `@/generated/prisma` or use `Prisma.<Type>` helpers.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Generated client lives inside src/ so imports stay typed and bundler-friendly
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// BETTER AUTH — Core authentication models
// ============================================================================
//
// These models are required by Better Auth and its plugins. The shape is
// defined by Better Auth's schema generator — do NOT rename fields without
// also updating the auth config and re-running `npx @better-auth/cli generate`.
//
// SOURCE OF TRUTH KEYWORDS: User, Session, Account, Verification, TwoFactor
// ============================================================================

/// User — the primary identity record. Links to all auth credentials,
/// organization memberships, sessions, and audit logs.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // Better Auth twoFactor plugin — flag indicating 2FA is enabled
  twoFactorEnabled Boolean? @default(false)

  // Better Auth admin plugin — 'admin' grants impersonation + admin endpoint access
  role       String?
  banExpires DateTime?
  banReason  String?
  banned     Boolean?  @default(false)

  // Application-level fields
  onboardingComplete Boolean @default(false)
  firstName          String?
  lastName           String?

  // Relations
  accounts         Account[]
  sessions         Session[]
  twofactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  activityLogs     ActivityLog[]
  cardFingerprints CardFingerprint[]

  @@map("user")
}

/// Session — issued at sign-in, validated on every request.
/// `activeOrganizationId` powers the org-scoped procedure (set lazily by
/// Better Auth's organization plugin or by our session-create hook).
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  // Better Auth organization plugin — current active org for this session
  activeOrganizationId String?

  // Better Auth admin plugin — impersonation chain (admin user ID)
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

/// Account — credential record, one per provider per user (email+password,
/// google, github, etc.). The `password` field stores the hash for email auth.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

/// Verification — short-lived tokens for email verification, password reset,
/// magic links, etc. Cleaned up automatically once consumed or expired.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

/// TwoFactor — TOTP secret + backup codes for the 2FA plugin.
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

// ============================================================================
// ORGANIZATIONS — Multi-tenancy core
// ============================================================================
//
// Every domain entity in this app should hang off Organization via an
// `organizationId` foreign key. The protectedProcedure (see src/trpc/
// procedures/protected.ts) guarantees that the active organization is
// always present in ctx, so all queries can be safely scoped by tenant.
//
// SOURCE OF TRUTH KEYWORDS: Organization
// ============================================================================

/// Organization — a tenant. Owns all members, subscriptions, and domain data.
model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  // Billing — Stripe customer for this tenant. Set on first checkout / when a
  // card is added, so a free org can store a payment method before subscribing.
  // The Subscription model also carries stripeCustomerId; this is the durable
  // org-level handle used by resolveExistingStripeCustomerId (payment.service).
  stripeCustomerId String?

  // Platform admin — when true, this org is the operator's "portal" workspace.
  // getOrganizationTier short-circuits it to the hidden, unlimited `portal`
  // tier, and its members get the /portal super-admin console. Bootstrapped
  // from PORTAL_INITIAL_OWNER_EMAIL (src/lib/config/portal.ts).
  isPortalOrganization Boolean @default(false)

  // Credits — a CACHE OF THE LEDGER SUM, never an independent number. Every
  // write that changes it appends a CreditLedger row in the SAME transaction,
  // so the two can only disagree if a transaction boundary is wrong — which is
  // exactly what the nightly `credits.reconcile` cron looks for and reports.
  //
  // It exists because the alternative is summing the ledger on every read, and
  // the ledger is append-only and unbounded: a workspace that has been
  // rendering for a year would pay for thousands of rows to answer "can I
  // afford this", on the request path, before every paid action.
  //
  // NEVER write this without a ledger row beside it. The ledger is the truth;
  // this is the fast answer. See src/services/credits.service.ts.
  creditBalance Int @default(0)

  // Relations
  members           Member[]
  invitations       Invitation[]
  organizationroles OrganizationRole[]
  subscriptions     Subscription[]
  usageMetrics      UsageMetrics[]
  activityLogs      ActivityLog[]
  projects          Project[]
  assets            Asset[]
  renders           Render[]
  creditLedger      CreditLedger[]
  scriptBlocks      ScriptBlock[]
  speakers          Speaker[]
  narrationLines    NarrationLine[]

  @@map("organization")
}

/// Member — links a User to an Organization with a role (owner | admin | member
/// | <custom-role>). Custom roles are defined in OrganizationRole.
///
/// SOURCE OF TRUTH KEYWORD: Member
model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One membership per (organization, user). Every create site already guards
  /// with a findFirst, but those are check-then-act with nothing behind them:
  /// two concurrent invitation accepts can both pass the check. Better Auth's
  /// own organization endpoints also write this table through prismaAdapter,
  /// outside those guards entirely. The constraint is what actually makes the
  /// rule true — note it turns a previously-silent duplicate into a P2002.
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

/// Invitation — pending invite to join an organization. Becomes a Member on
/// accept; cancellation or expiration deletes the row (hard delete only, per
/// the project's no-soft-delete rule). The mere existence of a row implies
/// "pending"; status is encoded by presence rather than a column.
model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

/// OrganizationRole — custom roles created per-org. ONE row per (organization,
/// role); the `permission` column stores a JSON object map of the form
/// `{ "<resource>": ["<action>", ...] }` (e.g. `{"member":["read"],"projects":
/// ["read","create"]}`). The organizationRoles router writes it; the tRPC
/// context (src/trpc/init.ts) JSON-parses it and flattens to `resource:action`
/// strings to drive requirePermission checks. The static `owner` role is NOT
/// stored here — owners get a sentinel "all access" in the context resolver.
///
/// Use this together with the permission statement built in
/// src/lib/better-auth/permissions.ts.
///
/// SOURCE OF TRUTH KEYWORD: OrganizationRole
model OrganizationRole {
  id             String    @id
  organizationId String
  role           String
  permission     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organizationRole")
}

// ============================================================================
// BILLING — Subscription tier (drives feature gates)
// ============================================================================

/// Subscription — links an Organization to a Stripe subscription and plan tier.
/// The `plan` field MUST match a key in `PLANS` (src/lib/config/plans.ts) — e.g.
/// "free" | "starter" | "pro" | "enterprise". Resolving the org's tier reads
/// this row's plan when status is active/trialing.
///
/// SOURCE OF TRUTH KEYWORD: Subscription
model Subscription {
  id                   String    @id
  plan                 String // Must match a key in `PLANS` (src/lib/config/plans.ts)
  referenceId          String // Organization ID this subscription belongs to
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete") // incomplete|active|trialing|past_due|canceled
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

/// CardFingerprint — free-trial abuse prevention. Stores the Stripe card
/// `fingerprint` (a stable hash of the card, identical across re-tokenizations
/// and across customers) per user, with a `usedFreeTrial` flag. Before granting
/// a trial, billing checks whether this user OR any user has already used a
/// trial with the same card fingerprint. Tracking is best-effort and
/// non-critical: every read fails OPEN (allows the trial) so a Stripe/DB hiccup
/// never blocks a legitimate signup.
///
/// SOURCE OF TRUTH KEYWORD: CardFingerprint
model CardFingerprint {
  id            String   @id @default(cuid())
  userId        String
  fingerprint   String // Stripe card fingerprint (pm.card.fingerprint)
  usedFreeTrial Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per (user, card); fingerprint indexed for the cross-user lookup.
  @@unique([userId, fingerprint])
  @@index([fingerprint])
  @@index([userId])
  @@map("cardFingerprint")
}

// ============================================================================
// FEATURE GATE USAGE TRACKING
// ============================================================================

/// UsageMetrics — current consumption of a "limit" resource for an org.
/// Writes happen via incrementUsage() / decrementUsage() in
/// src/services/usage.service.ts. Reads happen via getFeatureGates() in
/// src/lib/feature-gate.ts, which combines this with the plan config to
/// compute remaining quota.
///
/// One row per (organization, featureKey). The `featureKey` column stores the
/// BARE resource key from `RESOURCES` (src/lib/resources.ts) — e.g. `"projects"`,
/// `"storage"`, `"apiCalls"`. The column name is historical; semantically it is
/// a `LimitResourceKey`.
///
/// SOURCE OF TRUTH KEYWORD: UsageMetrics
model UsageMetrics {
  id             String   @id @default(cuid())
  organizationId String
  featureKey     String // A LimitResourceKey from `RESOURCES` (src/lib/resources.ts)
  currentUsage   Int      @default(0)
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite uniqueness so each org has at most one row per featureKey
  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("usageMetrics")
}

// ============================================================================
// AUDIT LOG (forensic-grade)
// ============================================================================

/// ActivityLog — append-only audit trail. Written via logActivity() in
/// src/services/activity-log.service.ts inside the same transaction as the
/// handler mutation, so the audit row and the business data commit together
/// (or both roll back).
///
/// SECURITY: ipAddress and userAgent are forensic fields. They are written
/// by the server (via getRequestForensics) and MUST NEVER be returned to
/// any frontend endpoint. Reads from this table go through the
/// AUDIT_LOG_SAFE_SELECT pick which deliberately omits both fields.
///
/// SOURCE OF TRUTH KEYWORD: ActivityLog
model ActivityLog {
  id             String   @id @default(cuid())
  userId         String // Actor — the user who performed the action
  organizationId String // Tenant scope
  action         String // "create" | "update" | "delete" | <custom verb>
  entity         String // Entity type — e.g., "project", "member", "invitation"
  entityId       String? // Affected entity ID (optional for org-level actions)
  description    String? // Human-readable summary, e.g., "Renamed Project 'A' → 'B'"
  metadata       Json? // Structured before/after diff or extra context
  ipAddress      String? // FORENSIC ONLY — never exposed to frontend
  userAgent      String? // FORENSIC ONLY — never exposed to frontend
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Indexes tuned for the most common queries: org timeline, user timeline,
  // and recent-activity dashboards. Add additional indexes only when a real
  // query proves they're needed.
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entity])
  @@map("activity_log")
}

// ============================================================================
// VIDEO STUDIO — Projects and their timeline documents
// ============================================================================

/// Project — one video being made inside a workspace. The row holds everything
/// cheap to query (title, kind, status); the expensive part — the timeline
/// document itself — lives in the 1:1 Timeline row so a project list never
/// drags a 200KB jsonb column along with it.
///
/// BRANCH POLICY (decided in Phase 01, implemented in Phase 15): regenerating a
/// project whose `manualEdited` is true NEVER overwrites the edited timeline. It
/// creates a NEW Project row with `parentId` pointing at the edited one, so the
/// manual work survives as its own version. `versions` is that back-relation.
///
/// `kind` and `status` are String, not Prisma enums — this schema has zero enum
/// blocks and the validated unions live in src/lib/types/project.ts.
///
/// SOURCE OF TRUTH KEYWORD: Project
model Project {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  kind           String // reddit-story | voiceover | quiz | motion
  status         String   @default("draft") // draft | generating | ready | failed | cancelled
  aspect         String   @default("9:16")
  manualEdited   Boolean  @default(false)
  parentId       String? // set when a regeneration branched off an edited project
  settings       Json?
  sourceRef      String? // the Reddit URL, the topic, the uploaded doc key
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Project?        @relation("ProjectVersions", fields: [parentId], references: [id])
  versions       Project[]       @relation("ProjectVersions")
  timeline       Timeline?
  renders        Render[]
  scriptBlocks   ScriptBlock[]
  speakers       Speaker[]
  narrationLines NarrationLine[]
  alignment      Alignment?
  pipelineStages PipelineStage[]

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([parentId])
  @@map("project")
}

/// Timeline — the versioned timeline document for one project, keyed by
/// projectId (no surrogate id: the relation is strictly 1:1).
///
/// `docVersion` is the DOCUMENT SCHEMA version, migrated on every read by
/// migrate() in src/lib/timeline/migrate.ts. `revision` is the OPTIMISTIC
/// CONCURRENCY counter the editor bumps per save — two different numbers that
/// are easy to confuse. Nothing reads `doc` without passing it through
/// migrate() first.
///
/// SOURCE OF TRUTH KEYWORD: Timeline
model Timeline {
  projectId  String   @id
  docVersion Int
  doc        Json
  revision   Int      @default(0)
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("timeline")
}

// ============================================================================
// MEDIA — one asset system for uploads, library media, generated clips, renders
// ============================================================================

/// Asset — one piece of media, whatever produced it: a customer upload, a
/// curated library background, generated narration, generated footage, or a
/// finished render. ONE table rather than one per source, because every
/// consumer downstream (the timeline document, the renderer, the media picker)
/// wants the same five answers — where are the bytes, how long is it, what
/// shape is it, is it ready, may this workspace use it.
///
/// LIBRARY ROWS HAVE A NULL organizationId. That is the only reason the column
/// is nullable, and it has a consequence every query has to respect: an
/// ownership check is "mine OR library", never "not null" and never
/// `organizationId !== null`. Writing the check the obvious way hands every
/// workspace every other workspace's media the first time someone passes an id.
/// See findAssetForOrganization in src/services/assets.service.ts — it is the
/// one place that check is written.
///
/// BYTES ARE METERED ON `storage`, NOT ON A LIMIT OF ITS OWN. `assets` declares
/// no `limit` in src/lib/resources.ts, so the procedure factory does not bump a
/// counter for it; `assets.completeUpload` adds `bytes` to the `storage`
/// counter by hand and `assets.delete` subtracts the same number back. `bytes`
/// is therefore not merely informational — it is the quantity the quota is
/// charged on, so it must be the real object size, never an estimate.
///
/// `kind`, `source`, `status` and `moderationStatus` are String, not Prisma
/// enums — this schema has zero enum blocks and the validated unions live in
/// src/lib/types/asset.ts.
///
/// SOURCE OF TRUTH KEYWORD: Asset
model Asset {
  id               String   @id @default(cuid())
  organizationId   String? // null for library assets — see the note above
  kind             String // background | upload | ai_footage | image | audio_tts | audio_music | sfx | render_output | avatar
  source           String // library | upload | generated | stock
  filename         String
  storageKey       String
  contentType      String
  bytes            Int
  durationSec      Float? // Phase 11 loops a background shorter than the narration off this
  width            Int?
  height           Int?
  license          String   @default("owned")
  minPlan          String? // library gating only (Phase 11)
  moderationStatus String   @default("pending") // pending | approved | rejected | skipped
  status           String   @default("processing") // processing | ready | failed
  error            String? // the readable reason a failed ingest gives the customer
  promptText       String? // ai_footage auditing (Phase 17)
  modelVersion     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants     AssetVariant[]

  @@index([organizationId])
  @@index([organizationId, kind])
  @@index([kind, source])
  @@map("asset")
}

/// AssetVariant — a derived rendition of an Asset: the 9:16 master the renderer
/// uses, the small proxy the browser previews with, a poster frame, a waveform
/// image.
///
/// Rows are UPSERTED per variant by the ingest workflow, one step each, which
/// is what makes a retry resume instead of restarting: a run that already
/// produced `vertical_1080` and then failed on `thumb` re-enters with the
/// master still recorded. `@@unique([assetId, variant])` is what makes that
/// upsert well-defined.
///
/// `bytes` here is NOT added to the `storage` counter. Derived renditions are a
/// cost of storing the original, and charging a customer three times for one
/// upload — once for the file and twice for variants they never asked for —
/// would make the quota unexplainable. Deleting the asset still deletes these
/// objects; see DELETE_REMOVES_EVERY_OBJECT in src/services/assets.service.ts.
///
/// SOURCE OF TRUTH KEYWORD: AssetVariant
model AssetVariant {
  id         String @id @default(cuid())
  assetId    String
  variant    String // vertical_1080 | proxy_480 | thumb | waveform
  storageKey String
  width      Int?
  height     Int?
  bytes      Int

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, variant])
  @@index([assetId])
  @@map("asset_variant")
}

// ============================================================================
// RENDERING — one row per paid render, keyed so an unchanged project is free
// ============================================================================

/// Render — one attempt to turn a project's timeline into a video file.
///
/// `docHash` IS THE CACHE KEY AND IT IS NOT JUST THE DOCUMENT'S HASH. It is
/// built by renderCacheKey() in src/lib/render/cache-key.ts, which folds
/// hashDoc(doc) together with every setting that changes the PIXELS — the
/// resolution and the watermark. The column keeps the brief's name because
/// that is what the phase and the architecture call it, but storing a bare
/// hashDoc() here would be a correctness bug with a bill attached, twice over:
/// a 720p render would satisfy a later request for 1080p, and a free
/// workspace's watermarked output would be handed back after it upgraded. The
/// whole point of `@@unique([projectId, docHash])` is that reuse is correct
/// rather than best-effort, and it is only correct if the key says everything
/// about the output.
///
/// `providerRenderId` IS UNIQUE, which is what makes the retry rule in step 8
/// of the phase enforceable rather than aspirational: a retry must start a
/// FRESH provider render and overwrite this column, because reusing the old id
/// would collide and because a second webhook for the old id must not be able
/// to resurrect a render that was already marked failed.
///
/// `status` is String, not a Prisma enum — this schema has zero enum blocks and
/// the validated union lives in src/lib/types/render.ts (renderStatusSchema).
///
/// `creditsCharged` and `costBreakdown` stay NULL in this phase. Phase 05 owns
/// them; writing a number here now would be a charge nothing audited.
///
/// SOURCE OF TRUTH KEYWORD: Render
model Render {
  id               String    @id @default(cuid())
  organizationId   String
  projectId        String
  providerRenderId String?   @unique
  docHash          String
  status           String    @default("queued") // queued | rendering | completed | failed | timedOut
  progress         Float     @default(0)
  resolution       String    @default("1080p") // 720p | 1080p
  watermark        Boolean   @default(true)
  outputAssetId    String?
  posterAssetId    String?
  attempts         Int       @default(1)
  creditsCharged   Int? // populated in Phase 05
  costBreakdown    Json?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, docHash])
  @@index([organizationId])
  @@index([projectId])
  @@index([organizationId, createdAt])
  @@map("render")
}

// ============================================================================
// CREDITS — a ledger, because a counter cannot express a hold or a refund
// ============================================================================

/// CreditLedger — append-only. Every credit that enters or leaves a workspace
/// is a row here, and `Organization.creditBalance` is only ever a cache of
/// their sum (written in the same transaction, never on its own).
///
/// WHY A LEDGER AND NOT A `UsageMetrics` COUNTER. A counter can increment and
/// decrement and that is all it can say. Paid work here has three properties a
/// counter has no vocabulary for: a render's true cost is unknown until it
/// finishes, a failed render must give the money back, and a top-up has to
/// survive a plan change. Expressing that on a counter means hand-written
/// compensation on every failure path — and the first failed render gets it
/// wrong. So countable product objects (`projects`, `renders`, `storage`) stay
/// on the registry and its automatic gates, and variable-cost work lives here.
///
/// THE HOLD/COMMIT/RELEASE SHAPE, which is what makes "nobody is charged for a
/// video that was not made" true rather than aspirational:
///
///   hold    — negative, written BEFORE the paid work starts. The money is
///             reserved, so a second render cannot spend it while the first is
///             running.
///   commit  — negative, written when the work finished, for its REAL cost.
///   release — positive, reversing a hold in full (failure) or in part (the
///             work cost less than estimated).
///
/// A hold is therefore always followed by exactly one of: a commit plus a
/// release for the difference, or a release for the whole amount. `holdId`
/// links both back, and it is what makes double-commit detectable — see
/// `commit` in src/services/credits.service.ts.
///
/// `delta` IS SIGNED and the sign is not derivable from `kind` alone by a
/// reader skimming: hold and commit are negative, purchase/grant/release are
/// positive. Storing the sign rather than an absolute value is what lets the
/// balance be `SUM(delta)` with no branching, which is the property the
/// reconcile cron depends on.
///
/// `kind` is String, not a Prisma enum — this schema has zero enum blocks and
/// the validated union lives in src/lib/types/credits.ts.
///
/// SOURCE OF TRUTH KEYWORD: CreditLedger
model CreditLedger {
  id             String   @id @default(cuid())
  organizationId String
  delta          Int // negative for hold/commit, positive for purchase/grant/release
  kind           String // purchase | grant | hold | commit | release
  refId          String? // renderId, jobId, stripe payment intent
  holdId         String? // links commit/release back to its hold
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([holdId])
  @@index([refId])
  @@map("credit_ledger")
}

/// StripeEvent — every Stripe event id this app has already processed.
///
/// WHY IT EXISTS, and why Phase 05 is where it became urgent. Stripe delivers
/// at least once and replays on its own schedule; until now the webhook's
/// replay safety was INCIDENTAL, resting on the fact that upserting by
/// subscription id happens to be idempotent. One handler was never idempotent
/// at all — `markUserFingerprintsAsTrialUsed` genuinely re-runs on every
/// replay — and it was harmless only because re-marking a used trial as used
/// changes nothing.
///
/// Credits remove that luck. A replayed top-up that grants a second time is a
/// direct, unrecoverable loss, so the webhook now inserts this row FIRST and
/// bails if it already exists. The primary key IS the Stripe event id, so the
/// database itself refuses the second insert — the check and the guarantee are
/// the same operation, which is the only version of this that cannot race.
///
/// SOURCE OF TRUTH KEYWORD: StripeEvent
model StripeEvent {
  id          String   @id // the Stripe event id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_event")
}

// ============================================================================
// SCRIPTS — the editable text a video is generated from
// ============================================================================

/// ScriptBlock — one addressable chunk of narration: a hook, a body beat, or a
/// call to action. A project's script is its blocks in `position` order.
///
/// WHY ROWS AND NOT A JSON COLUMN ON Project. The editor edits ONE block at a
/// time — inline text edits, drag to reorder, delete, and per-block
/// regenerate — and `scripts.regenerateBlock` must leave every other block
/// BYTE-IDENTICAL. A JSON blob makes each of those a read-modify-write of the
/// whole script, so two people editing different blocks, or a regenerate
/// racing an edit, silently discards one of them. Rows make the unit of
/// concurrency the same as the unit of editing.
///
/// `position` IS NOT THE PRIMARY KEY and is not unique. Reordering a list by
/// rewriting a unique column needs either a temporary gap or a deferred
/// constraint, and both are how a drag-to-reorder ends in a constraint
/// violation halfway through. Order is `@@index([projectId, position])` and
/// ties break on `createdAt`, so a duplicate position is ugly rather than
/// fatal.
///
/// `durationEstimate` is SECONDS, derived from the word count at a speaking
/// rate (see WORDS_PER_SECOND in src/lib/types/script.ts). It is stored rather
/// than computed on read because the pacing warning and the credit estimate
/// both need the total, and recomputing it per request would mean the number
/// shown and the number charged could drift apart.
///
/// `speakerTag` is nullable and unused in this phase — Phase 12 splits a
/// Reddit thread into multiple speakers and Phase 07 maps a tag to a voice.
/// It is in the schema now because adding it later would mean a migration on a
/// table that by then holds every customer's scripts.
///
/// `sectionType` is String, not a Prisma enum — this schema has zero enum
/// blocks and the validated union lives in src/lib/types/script.ts.
///
/// SOURCE OF TRUTH KEYWORD: ScriptBlock
model ScriptBlock {
  id               String   @id @default(cuid())
  organizationId   String
  projectId        String
  position         Int
  sectionType      String // hook | body | cta
  narrationText    String
  durationEstimate Float
  speakerTag       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId, position])
  @@map("script_block")
}

// ============================================================================
// VOICES AND NARRATION — who speaks, and the audio of them speaking
// ============================================================================

/// Voice — one entry in the SHARED voice catalogue.
///
/// NO organizationId, deliberately: this is a catalogue every workspace reads,
/// exactly like a library Asset with a null organizationId. Voices are
/// licensed by the operator once, not per tenant, so a per-workspace copy
/// would be the same licence duplicated per customer and a catalogue update
/// that had to be fanned out across every tenant.
///
/// NO CLONES OF REAL PEOPLE OR THIRD-PARTY CHARACTERS, EVER. That is a legal
/// position, not a preference, and it is why `providerVoiceId` points at a
/// LICENSED library voice rather than at anything this product generated.
/// Phase 07's brief states it; nothing in this schema should ever be used to
/// store a cloned voice.
///
/// `minPlan` gates the voice, and it is a STRING matching a PlanKey rather
/// than a boolean "premium" flag — a boolean cannot express a voice available
/// from Pro upward while another is available from Starter, and the first time
/// a third tier of voices is wanted the boolean has to be migrated anyway.
///
/// `previewAssetId` points at a PRE-RENDERED sample. Previews are served from
/// that asset rather than synthesised on demand, so hearing a voice costs no
/// credits and no provider call — see the preview note in the phase brief: the
/// upsell is hearing what you cannot yet use.
///
/// SOURCE OF TRUTH KEYWORD: Voice
model Voice {
  id              String  @id @default(cuid())
  name            String
  gender          String
  accent          String
  tone            String
  providerVoiceId String
  provider        String  @default("elevenlabs")
  minPlan         String  @default("free")
  previewAssetId  String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per provider voice. The sync upserts on this, so re-running it
  /// updates the catalogue rather than duplicating it.
  @@unique([provider, providerVoiceId])
  @@index([minPlan])
  @@index([isActive])
  @@map("voice")
}

/// Speaker — a role in one project's script, and the voice assigned to it.
///
/// `tag` is the label the SCRIPT uses ("A", "OP", "narrator"), which is what
/// makes a speaker addressable before a voice has been chosen: Phase 06 writes
/// `ScriptBlock.speakerTag` with no knowledge of voices, and Phase 12 splits a
/// Reddit thread into tags long before anybody picks who sounds like what.
///
/// `@@unique([projectId, tag])` is what makes assignment well-defined — two
/// rows for tag "A" would mean a line could be synthesised in two voices
/// depending on which row was read.
///
/// `voiceId` is NULLABLE and that is the whole point of the `state` column: a
/// project with an unassigned speaker must be BLOCKED from generating rather
/// than silently narrated in a default voice. See validateAssignments.
///
/// `avatarId` is unused in this phase — Phase 12 pairs a speaker with a
/// character. It is here now because adding it later means a migration on a
/// table that by then holds every project's cast.
///
/// SOURCE OF TRUTH KEYWORD: Speaker
model Speaker {
  id             String  @id @default(cuid())
  organizationId String
  projectId      String
  tag            String
  voiceId        String?
  avatarId       String?
  state          String  @default("unassigned") // unassigned | ready

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tag])
  @@index([organizationId])
  @@map("speaker")
}

/// NarrationLine — one spoken line and the audio of it.
///
/// A `ScriptBlock` becomes one or more of these: split by speaker, and by
/// sentence where a block is long enough that re-recording it whole would be
/// wasteful. The line is the unit of SYNTHESIS and of re-synthesis, which is
/// why it is a row rather than a field on the block.
///
/// `textHash` IS THE CACHE KEY AND IT COVERS THE VOICE. It is
/// `hash(text + voiceId)`, because the same words in a different voice are a
/// different recording — a hash of the text alone would hand a customer the
/// previous speaker's audio the moment they changed the cast. Grep
/// TEXT_HASH_COVERS_THE_VOICE.
///
/// The `@@index([textHash, voiceId])` is what makes the cache lookup cheap:
/// before synthesising, a ready line with the same hash is reused. Re-running
/// generation on unchanged text therefore makes ZERO provider calls, which is
/// one of the phase's "done when" checks.
///
/// `durationSec` is the MEASURED duration, written after loudness
/// normalisation — not the provider's estimate. The timeline positions every
/// other element against these numbers, so an estimate here desynchronises the
/// whole video.
///
/// `status` is String, not a Prisma enum — zero enum blocks in this schema;
/// the validated union lives in src/lib/types/voice.ts.
///
/// SOURCE OF TRUTH KEYWORD: NarrationLine
model NarrationLine {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  position       Int
  speakerTag     String
  voiceId        String?
  text           String
  textHash       String
  audioAssetId   String?
  durationSec    Float?
  status         String   @default("pending") // pending | synthesizing | ready | failed
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId, position])
  @@index([textHash, voiceId])
  @@map("narration_line")
}

/// Alignment — the word-level timings for one project's narration.
///
/// KEYED BY projectId, WITH NO SURROGATE ID. A project has exactly one
/// alignment, the same way it has exactly one Timeline: the words are a
/// property of the narration as a whole, not a list of per-line fragments.
/// Storing one row per line was the alternative and it loses the only thing
/// the renderer actually wants — a single array whose index IS the
/// `wordIndex` a caption item and a motion anchor resolve against.
///
/// `words` IS A `WordToken[]` AS JSON, validated by `wordTokenSchema` in
/// src/lib/timeline/schema.ts on every read. Json rather than a table of
/// words because a sixty-second video is roughly 180 of them, they are
/// written once as a unit, read once as a unit, and never queried
/// individually — a `word` table would be 180 rows per project earning
/// nothing but a join.
///
/// `audioHash` IS THE CACHE KEY AND IT COVERS EVERY LINE'S AUDIO. Alignment
/// is paid provider work and audio rarely changes, so a re-run whose hash
/// matches the stored one skips the provider entirely — one of the phase's
/// "done when" checks. The hash is built from the ordered `textHash` of every
/// ready narration line (see alignmentAudioHash in src/lib/alignment/hash.ts),
/// so re-recording ONE line changes it and a restyle does not. Grep
/// AUDIO_HASH_COVERS_EVERY_LINE.
///
/// `degraded` MEANS THE TIMINGS ARE EVENLY DISTRIBUTED, NOT MEASURED. The
/// phase's rule is degrade, never fail: if the aligner fails twice, words are
/// spread across the known narration duration and the video still renders,
/// flagged. The flag is the only thing standing between that and a customer
/// believing the captions are accurate, so it is a column rather than an
/// inference. Grep DEGRADE_NEVER_FAIL.
///
/// `engine` records WHICH aligner produced this — the provider id, or
/// `even-distribution` for a degraded row. A sudden run of degraded rows is
/// the signal that the provider is unhealthy.
///
/// SOURCE OF TRUTH KEYWORD: Alignment
model Alignment {
  projectId String   @id
  words     Json
  audioHash String
  engine    String
  degraded  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([audioHash])
  @@map("alignment")
}

/// PipelineStage — one step of one project's generate pipeline, with when it
/// started, when it ended, and why it stopped if it did.
///
/// WHY A TABLE AND NOT A JSON COLUMN ON `project`. Three different readers want
/// this: the progress subscription, the plain polling query it falls back to,
/// and the failure screen that has to name the stage that broke. A jsonb blob
/// would make "which stage is running" a read-modify-write of the whole
/// document from inside a workflow step — two stages finishing at once would
/// lose one of them. A row per stage makes each transition its own upsert,
/// which is what lets the fan-out write concurrently and still be correct.
///
/// THE STAGE NAMES ARE FIXED and listed in src/lib/types/pipeline.ts. `stage`
/// is a String for the same reason every other status column here is — this
/// schema has zero enum blocks — so PIPELINE_STAGES is the only thing standing
/// between a typo and a progress list with a phantom row in it.
///
/// A KIND THAT SKIPS A STAGE WRITES `skipped`, NEVER OMITS IT. The progress UI
/// renders the full ordered list, so an omitted stage would make the list
/// reshuffle as the run proceeds — the one thing a progress display must not
/// do. Grep SKIPPED_NOT_OMITTED.
///
/// `@@unique([projectId, stage])` is what makes a step's entry and exit write
/// an UPSERT rather than an insert, and therefore what makes a replayed
/// Inngest step idempotent: a resumed run re-entering `script` updates the row
/// it already wrote instead of adding a second one.
///
/// SOURCE OF TRUTH KEYWORD: PipelineStage
model PipelineStage {
  id         String    @id @default(cuid())
  projectId  String
  stage      String
  status     String    @default("pending") // pending | running | completed | failed | skipped
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stage])
  @@index([projectId])
  @@map("pipeline_stage")
}
