# ===========================================================================
# Database — REQUIRED
# ===========================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ===========================================================================
# AUTH PROVIDER — the switch the whole stack hangs off
# ===========================================================================
# This ONE variable decides who handles authentication, organizations, and
# billing. It is read in exactly one place (src/lib/adapters/provider.ts) and
# every other module asks that module, so the server and the browser can never
# disagree about which provider is live.
#
#   "better-auth"  (DEFAULT when unset — and the only provider that ships here)
#       Fully open source. Better Auth + Prisma + Stripe, all self-hosted.
#       You own the data, the UI, and the billing account. No third party can
#       change your pricing or deprecate your login screen.
#
# ADDING A PROVIDER is a plug-in, not a rewrite. Nothing in the app talks to a
# provider directly — everything goes through the AuthAdapter contract in
# src/lib/adapters/types.ts. A new provider is four additions:
#   1. its id in AUTH_PROVIDER_IDS            (src/lib/adapters/types.ts)
#   2. src/lib/adapters/<provider>/index.ts   — the server translator
#   3. src/components/global/providers/active.<provider>.tsx — its UI surfaces
#   4. an alias branch on this variable       (next.config.ts)
# TypeScript fails until all four exist, so a half-added provider cannot ship.
#
# PROVIDERS NEVER RUN SIDE BY SIDE. An unselected provider's code is not
# imported, its SDK never initialises, and its API routes return 404. An eslint
# rule blocks importing a provider SDK outside its own adapter folder, so the
# isolation cannot be broken by a later edit.
#
# SWITCHING IS NOT A MIGRATION. Changing this value does NOT move accounts
# between providers — users who signed up under one provider do not exist in the
# other. Switch on a fresh database, or migrate accounts deliberately.
#
# What stays yours under EVERY provider: the feature registry
# (src/lib/resources.ts), per-tenant roles and permissions, usage counters, and
# the audit log. Those are app-owned tables no provider can host.
NEXT_PUBLIC_AUTH_PROVIDER="better-auth"

# ===========================================================================
# Better Auth — REQUIRED only when NEXT_PUBLIC_AUTH_PROVIDER="better-auth"
# ===========================================================================
# REQUIRED in production. Generate with: openssl rand -base64 32
# (The dev fallback in auth.ts is going away — production must set this.)
BETTER_AUTH_SECRET=""
# Public origin Better Auth signs callbacks against. Must match APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================================================
# Google OAuth — OPTIONAL
# ===========================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================================================
# App branding (public)
# ===========================================================================
NEXT_PUBLIC_APP_NAME="Web Prodigies"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used in <meta name="description"> and OG cards. Optional — falls back to
# "<APP_NAME> — multi-tenant SaaS." when unset.
NEXT_PUBLIC_APP_DESCRIPTION=""
# Bare apex domain used by the auth layer for cross-subdomain cookies.
# Set this when you serve the app from multiple subdomains (e.g. app.x.com
# and admin.x.com) so cookies are scoped to ".x.com". Leave unset locally.
NEXT_PUBLIC_APP_DOMAIN=""

# ===========================================================================
# Registration mode
# ===========================================================================
# "true"  → anyone can sign up (DEFAULT when unset)
# "false" → all sign-up paths are closed at the auth-hook layer
NEXT_PUBLIC_REGISTRATION_OPEN="true"

# ===========================================================================
# Upstash Redis — OPTIONAL
# ===========================================================================
# Powers rate limiting ONLY (NOT a query cache). When unset, rate limiters
# fail open and the app still runs — fine for local dev; configure in
# production to actually enforce limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===========================================================================
# Email — Resend — OPTIONAL (transactional email)
# ===========================================================================
# Powers verification, password-reset, and team-invitation emails. When
# RESEND_API_KEY is unset, the email service no-ops (and Better Auth logs the
# verification/reset URL to the server console) so local dev works without an
# account. Configure in production to actually deliver email.
RESEND_API_KEY=""
# The "From" address. Falls back to "onboarding@resend.dev" when unset (only
# valid for Resend test sends). Use a verified domain address in production.
RESEND_FROM_EMAIL=""

# ===========================================================================
# Stripe — billing — OPTIONAL (subscriptions)
# ===========================================================================
# Server secret + client publishable key. When STRIPE_SECRET_KEY is unset the
# billing layer fails soft (checkout/upgrade calls error clearly, the rest of
# the app runs). Use test keys (sk_test_… / pk_test_…) locally.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret for the /api/stripe/webhook endpoint. From the Stripe
# dashboard, or `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=""

# --- Plan → Stripe Price IDs ---------------------------------------------
# One recurring Price per (plan, interval) created in the Stripe dashboard.
# The "free" plan has no price. Map each paid plan key from src/lib/config/plans.ts.
NEXT_PUBLIC_STARTER_PRICE_MONTHLY=""
NEXT_PUBLIC_STARTER_PRICE_YEARLY=""
NEXT_PUBLIC_PRO_PRICE_MONTHLY=""
NEXT_PUBLIC_PRO_PRICE_YEARLY=""
NEXT_PUBLIC_ENTERPRISE_PRICE_MONTHLY=""
NEXT_PUBLIC_ENTERPRISE_PRICE_YEARLY=""

# --- Plan display names ---------------------------------------------------
# Rename any plan WITHOUT touching code. Blank/unset falls back to the default
# shown here. (The hidden "portal" admin tier can't be renamed.)
NEXT_PUBLIC_FREE_NAME="Free"
NEXT_PUBLIC_STARTER_NAME="Starter"
NEXT_PUBLIC_PRO_NAME="Pro"
NEXT_PUBLIC_ENTERPRISE_NAME="Enterprise"

# --- Plan descriptions ----------------------------------------------------
# The one-liner under each plan name on the pricing cards in the upgrade modal.
# Blank/unset falls back to the default shown here.
NEXT_PUBLIC_FREE_DESCRIPTION="Everything you need to try things out."
NEXT_PUBLIC_STARTER_DESCRIPTION="For a small team getting off the ground."
NEXT_PUBLIC_PRO_DESCRIPTION="For teams that need room to grow."
NEXT_PUBLIC_ENTERPRISE_DESCRIPTION="Unlimited scale with everything included."

# --- Show plan in the pricing table --------------------------------------
# "true" shows the plan in the pricing UI, "false" hides it (e.g. an Enterprise
# "contact us" tier). Hiding does NOT disable the plan — subscriptions/upgrades
# to it still work; it's only hidden from the pricing grid. Default: true.
NEXT_PUBLIC_FREE_SHOW_PLAN="true"
NEXT_PUBLIC_STARTER_SHOW_PLAN="true"
NEXT_PUBLIC_PRO_SHOW_PLAN="true"
NEXT_PUBLIC_ENTERPRISE_SHOW_PLAN="true"

# --- Free-trial length (days) --------------------------------------------
# Days of free trial when subscribing to each plan. 0 = no trial. Trial-abuse
# checks still apply. Default: free 0, starter 14, pro 14, enterprise 30.
NEXT_PUBLIC_FREE_TRIAL_DAYS="0"
NEXT_PUBLIC_STARTER_TRIAL_DAYS="14"
NEXT_PUBLIC_PRO_TRIAL_DAYS="14"
NEXT_PUBLIC_ENTERPRISE_TRIAL_DAYS="30"

# ===========================================================================
# Platform-admin portal — OPTIONAL
# ===========================================================================
# A private /portal admin area just for you, the app owner: see and manage
# every organization and user, and view activity across the whole app.
# It stays off until you set PORTAL_ENABLED to "true".
PORTAL_ENABLED="false"
# The email address you'll sign in with. When the portal is on, the first time
# this person signs in they automatically get admin access to /portal — you
# don't have to set up anything by hand. Leave blank if the portal is off.
PORTAL_INITIAL_OWNER_EMAIL=""
# Route prefix for the portal (default /portal).
PORTAL_PATH_PREFIX="/portal"

# ===========================================================================
# Background jobs (Inngest) — OPTIONAL in development
# ===========================================================================
# Durable multi-step work: video generation, rendering, asset ingest. A tRPC
# mutation runs inside a 10-second database transaction, so anything slower
# than a quick API call is enqueued here instead of awaited in the request.
#
# Local development needs NOTHING set: run `npx inngest-cli@latest dev` and it
# discovers http://localhost:3000/api/inngest automatically.
#
# Which engine to use. Only "inngest" exists today. Server-only on purpose —
# no browser code enqueues a job, so this never belongs in the client bundle.
JOBS_PROVIDER="inngest"
# Stable id for this app in the Inngest dashboard. Defaults to a slug of
# NEXT_PUBLIC_APP_NAME. Renaming the product should NOT change this, or
# in-flight runs are orphaned — set it explicitly before going to production.
INNGEST_APP_ID=""
# Required in production only. From the Inngest dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ===========================================================================
# Object storage (Cloudflare R2) — required before any media feature
# ===========================================================================
# Every uploaded video, generated audio clip and finished render lives here.
# Postgres stores only the key; the bytes are never in the database.
#
# Not needed to boot: the app runs and the setup checklist renders without
# these. The first media feature (Phase 02) is what requires them.
#
# Key layout, owned by src/lib/adapters/storage/keys.ts — never build a key
# by hand, the prefix is what enforces tenancy at the storage layer:
#   library/{backgrounds|music|sfx|avatars}/...
#   orgs/{organizationId}/uploads/{assetId}/...
#   orgs/{organizationId}/projects/{projectId}/{audio|footage|renders}/...
#   tmp/{jobId}/...            <- add an R2 lifecycle rule: delete after 24h
#
# Which store to use. Only "r2" exists today. Server-only: the browser gets
# signed URLs, never bucket configuration.
STORAGE_PROVIDER="r2"
# From the Cloudflare dashboard → R2 → Manage API tokens.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public CDN origin for library assets (backgrounds, music, avatars). These
# are public by definition, so they are served from the CDN rather than
# signed per request. Leave blank until you connect a domain to the bucket.
R2_PUBLIC_URL=""

# ===========================================================================
# Media processing (ffmpeg) — required before any upload can be used
# ===========================================================================
# Every upload is probed, transcoded to a 9:16 master, and given a small
# preview proxy, a poster frame and (for audio) a waveform by the
# `asset.ingest` workflow. That work shells out to ffmpeg and ffprobe.
#
# WHERE THIS RUNS, and it is not negotiable: ffmpeg runs in the process that
# runs the workflow, so that process has to be a long-lived CONTAINER — a Node
# worker serving /api/inngest, or a dedicated worker image. NOT a serverless
# function: an ffmpeg build is bigger than a serverless bundle, a transcode
# outlasts a serverless execution budget, and a retried step needs a real
# local disk. The full reasoning is in
# src/lib/adapters/media/types.ts (FFMPEG_RUNS_IN_A_CONTAINER).
#
# Not needed to boot: the app runs, builds and renders the setup checklist
# without ffmpeg installed. Uploads will land in the bucket and then be marked
# `failed` with a message naming these variables.
#
# Which implementation to use. Only "ffmpeg" exists today.
MEDIA_PROVIDER="ffmpeg"
# Absolute paths to the two binaries. Leave blank to resolve them on PATH,
# which is what a container image with `apt-get install ffmpeg` gives you.
FFMPEG_PATH=""
FFPROBE_PATH=""

# ===========================================================================
# Cloud rendering (Remotion Lambda) — required before any video can be EXPORTED
# ===========================================================================
# Previewing and editing work without any of this: the browser renders the
# timeline in the page. Producing the actual MP4 does not happen here — it
# happens in the cloud, split across many functions so a sixty-second video
# does not take sixty seconds of one machine to make.
#
# WHERE THIS RUNS, and why it differs from ffmpeg above: a render is ONE long
# job per project that parallelises across FRAMES, which is exactly what
# Lambda is good at; an ingest is MANY short jobs that each want a warm
# process and a local disk, which is exactly what it is bad at. The two seams
# reach opposite conclusions on purpose — the reasoning is in
# src/lib/adapters/render/types.ts (LAMBDA_IS_RIGHT_FOR_RENDERING).
#
# Not needed to boot: the app runs, builds, previews and edits without any of
# these. `renders.create` is what refuses.
#
# DEPLOY FIRST. Two commands, both from the Remotion CLI:
#   npx remotion lambda functions deploy
#   npx remotion lambda sites create src/remotion/index.ts --site-name=<name>
# The first prints the function name; the second prints the bucket and the
# deployed site. Full guide: https://www.remotion.dev/docs/lambda/setup
#
# LICENCE: Remotion is free for individuals and small teams and requires a
# paid company licence beyond that — https://www.remotion.dev/license. This is
# the point at which it starts running on your infrastructure at scale.
#
# Which renderer to use. Only "lambda" exists today. The seam is what lets a
# self-hosted renderer replace it without touching a workflow.
RENDER_PROVIDER="lambda"
# The region the function and the site were deployed to. Must be one Remotion
# Lambda supports — the adapter validates it against the SDK's own list rather
# than failing later with an error about a missing function.
REMOTION_AWS_REGION=""
# Printed by `remotion lambda functions deploy`.
REMOTION_FUNCTION_NAME=""
# The S3 bucket Remotion created for this region. Outputs land here first and
# are copied into R2 by the render workflow, so nothing permanent lives in it.
REMOTION_BUCKET_NAME=""
# The site name you passed to `sites create`, and its version.
#
# THE VERSION IS WHAT MAKES A DEPLOY REVERSIBLE AND SAFE. The serve URL is
# built from these two, so each deploy writes a NEW site and a render resolves
# its URL once, at start, and carries it for its whole life. Without that,
# deploying mid-render swaps the bundle under a render whose chunks are
# already being produced in parallel — and the result is not a failed render
# but a video whose first half came from one build and whose second half came
# from another. Rolling back is putting the old value back here; no redeploy.
REMOTION_SITE_NAME=""
REMOTION_SITE_VERSION=""
# Any long random string. The renderer signs its completion callback with it
# and /api/webhooks/remotion refuses a call it cannot verify, so a render
# cannot finish without it — the workflow refuses to START without it rather
# than discovering the problem 45 minutes and one full render later.
REMOTION_WEBHOOK_SECRET=""
#
# LOCAL DEVELOPMENT: the renderer calls back to NEXT_PUBLIC_APP_URL, and AWS
# cannot reach localhost. Point a tunnel at your dev server and set that
# variable to the tunnel URL, or renders will start and then time out.
